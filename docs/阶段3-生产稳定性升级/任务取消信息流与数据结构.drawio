    </mxGraphModel>
  </diagram>

  <diagram id="cancel-data" name="2-数据结构与状态">
    <mxGraphModel dx="1800" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>

        <mxCell id="dtitle" value="任务取消数据结构、标识关系与状态边界" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="430" y="20" width="1040" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="req" value="上位机请求：ServerStreamMessage&#xa;────────────────────&#xa;command_id: int64 ＝ 取消请求ID&#xa;command_time: int64&#xa;command_type: CANCEL_TASK_CMD&#xa;robot_id: int64&#xa;oneof data_json.task_cmd.task_id ＝ 目标任务ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="40" y="100" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="envelope" value="内部信封：CommandEnvelope&#xa;────────────────────&#xa;cmd_id: str ＝ 取消请求ID&#xa;cmd_time: int&#xa;cmd_type: CmdType.CANCEL_TASK_CMD&#xa;robot_id: int&#xa;data_json: {cancel_task_cmd: {task_id}}&#xa;data: CancelTaskCmd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="430" y="100" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="cancel_model" value="CancelTaskCmd&#xa;────────────&#xa;task_id: int&#xa;&#xa;只保存目标 ID&#xa;不解析完整 Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="820" y="115" width="210" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="cancel_cmd" value="取消请求 UnifiedCommand&#xa;────────────────────&#xa;command_id ＝ 取消请求ID&#xa;cmd_type = CANCEL_TASK_CMD&#xa;category = CONTROL&#xa;priority = 0（实际不进入普通队列）&#xa;data = CancelTaskCmd&#xa;status = PENDING → COMPLETED / FAILED&#xa;metadata.target_task_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1090" y="95" width="350" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="feedback_model" value="上位机反馈：ClientStreamMessage&#xa;────────────────────&#xa;command_id ＝ 取消请求ID&#xa;command_time = 发送时间&#xa;command_type = COMMAND_STATUS_UPDATE&#xa;robot_id&#xa;command_status.command_id ＝ 取消请求ID&#xa;command_status.command_type = CANCEL_TASK_CMD&#xa;status = COMPLETED / FAILED（主判断）&#xa;message = 详细状态消息（按需解析）&#xa;timestamp = 同一发送时间&#xa;retry_count = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1500" y="65" width="350" height="255" as="geometry"/>
        </mxCell>

        <mxCell id="ids" value="三个 ID 不可混用&#xa;────────────────────────────&#xa;cancel command_id：取消请求幂等与反馈&#xa;target task_id：活动业务任务注册表键&#xa;target command_id：原始 TASK_CMD 标识" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="575" y="330" width="390" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="registry" value="TaskScheduler._active_tasks[task_id]&#xa;────────────────────────────&#xa;command: 原 TASK_CMD UnifiedCommand&#xa;cancel_event: threading.Event&#xa;state: queued / running / cancelling / terminalizing / cancelled&#xa;cancel_complete_event: threading.Event&#xa;cancel_result: {success, message, target_command_id}&#xa;terminal_decision: CANCELLED / COMPLETED / FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="40" y="510" width="410" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="tombstone" value="_cancelled_task_generations[task_id]&#xa;────────────────────────────&#xa;success / message / target_command_id&#xa;auto_charge_decided: bool&#xa;auto_charge_result: dict&#xa;&#xa;用途：同一任务代际复用取消结果和回充决策，避免重复硬件动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="500" y="520" width="350" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="target_models" value="原任务内存状态&#xa;────────────────────&#xa;原 UnifiedCommand.status&#xa;QUEUED / RUNNING → CANCELLED&#xa;&#xa;Task.status → CANCELLED&#xa;Station.status → CANCELLED&#xa;已完成站点保持 COMPLETED&#xa;历史 FAILED 可覆盖为 CANCELLED&#xa;&#xa;当前进程内有效；不跨重启恢复业务任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="900" y="510" width="320" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="db_received" value="server_command_received&#xa;────────────────&#xa;msg_id = cancel command_id&#xa;cmd_type / robot_id / data_json&#xa;processed: false → true" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1280" y="360" width="260" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="db_cancel" value="task_cancel_requests&#xa;────────────────&#xa;cancel_command_id PK&#xa;target_task_id&#xa;status: pending → completed / failed&#xa;message / created_at / completed_at" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1580" y="350" width="270" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="db_commands" value="unified_commands&#xa;────────────────&#xa;原 TASK_CMD：queued/running → cancelled&#xa;取消 CANCEL_TASK_CMD：pending → completed/failed&#xa;内部 CHARGE_CMD：queued → completed/failed/cancelled&#xa;保存 error_message 和 metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1280" y="555" width="270" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="db_audit" value="task_history&#xa;────────────────&#xa;cancel_waiting_task / cancel_request&#xa;cancel_request_conflict&#xa;recover_pending_cancel&#xa;auto_charge_after_cancel" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1590" y="560" width="250" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="db_sent" value="server_command_sent&#xa;────────────────&#xa;msg_id = 发送记录 UUID&#xa;command_id = cancel command_id&#xa;msg_type = COMMAND_STATUS_UPDATE&#xa;data_json / status" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="1430" y="770" width="280" height="165" as="geometry"/>
        </mxCell>

        <mxCell id="state_cancel" value="取消请求状态&#xa;PENDING → COMPLETED / FAILED&#xa;终态重放保持不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="60" y="810" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="state_target" value="原任务状态&#xa;QUEUED / RUNNING → CANCELLED&#xa;terminalizing 后拒绝新取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="400" y="810" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="state_fault" value="停止/安全恢复失败&#xa;原任务仍 CANCELLED；取消请求 FAILED&#xa;hardware_fault_blocked=true&#xa;硬件关闭→启动成功后解除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="750" y="800" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="current_gap" value="安全姿态与自动回充&#xa;────────────────────────&#xa;task_cancel.safe_pose.arm_joints = [0,0,0,0,0,0]&#xa;charging.marker / auto_charge_after_cancel / priority=9&#xa;内部 CHARGE_CMD metadata：source、cancelled_task_id、cancel_command_id、task_enqueue_generation、charge_marker&#xa;内存 cancel_event：新任务到达时受控停止回充" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="d1">
          <mxGeometry x="60" y="950" width="990" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="de1" value="协议转换" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="req" target="envelope"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" value="data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="envelope" target="cancel_model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" value="包装" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="cancel_model" target="cancel_cmd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de4" value="终态反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="cancel_cmd" target="feedback_model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de5" value="cancel command_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="req" target="ids"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de6" value="target task_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="cancel_model" target="ids"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de7" value="以 task_id 查询" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="ids" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de8" value="取消完成后保存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="registry" target="tombstone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de9" value="command 指向原任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="d1" source="registry" target="target_models"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de10" value="接收记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="envelope" target="db_received"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de11" value="幂等登记" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="cancel_cmd" target="db_cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de12" value="命令持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="target_models" target="db_commands"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de13" value="审计" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="tombstone" target="db_audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de14" value="发送记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="feedback_model" target="db_sent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de15" value="状态语义" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="cancel_cmd" target="state_cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de16" value="状态语义" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="d1" source="target_models" target="state_target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de17" value="异常分支" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="d1" source="state_target" target="state_fault"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
