<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="cancel-flow" name="1-端到端信息流">
    <mxGraphModel dx="2050" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="任务取消：从上位机指令到唯一终态反馈（当前实现）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="1120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="legend1" value="蓝色：协议/通信　紫色：取消协调　橙色：调度/硬件　绿色：成功　红色：失败　灰色：持久化" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="1120" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="upper" value="上位机&#xa;ServerStreamMessage&#xa;command_id=取消请求ID&#xa;task_cmd.task_id=目标任务ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="210" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="grpc_in" value="serverCommand 双向流&#xa;接收 CANCEL_TASK_CMD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="285" y="135" width="190" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="convert" value="dataConverter&#xa;映射 CmdType&#xa;构建 CommandEnvelope + CancelTaskCmd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="严格校验通过？&#xa;robot_id / oneof=task_cmd&#xa;task_id &gt; 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="115" width="210" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="reject" value="拒绝命令&#xa;记录本地日志&#xa;不创建取消请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="270" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="save_received" value="RobotControlSystem&#xa;保存 server_command_received&#xa;processed=false" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="120" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="async" value="即时分流&#xa;request_cancel_task_async(cancel_command_id, task_id)&#xa;不进入 PriorityQueue&#xa;不发送 QUEUED/RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="110" width="280" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="capacity" value="同 ID 已有 Future？&#xa;协调器有容量？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1680" y="115" width="210" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="overload" value="容量耗尽&#xa;持久化取消请求 FAILED&#xa;不无限排队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1665" y="275" width="240" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="manager" value="TaskManager.request_cancel_task&#xa;以 cancel_command_id 做幂等 owner 选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="290" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="cancel_db" value="task_cancel_requests&#xa;INSERT OR IGNORE&#xa;pending / completed / failed&#xa;&#xa;unified_commands&#xa;保存 CANCEL_TASK_CMD" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="275" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="TaskScheduler.cancel_task(task_id)&#xa;在 _task_registry_lock 内查询 _active_tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="755" y="285" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="target_state" value="目标任务状态？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="190" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="queued" value="等待队列 queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="queued_cancel" value="设置 cancel_event&#xa;entry.state=cancelled&#xa;原 TASK_CMD / Task / 未完成 Station = CANCELLED&#xa;持久化并写 cancel_waiting_task 审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="25" y="535" width="220" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="queue_skip" value="对象可残留在 PriorityQueue&#xa;出队时二次检查并直接丢弃&#xa;不调用硬件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="25" y="700" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="queued_success" value="等待任务取消成功&#xa;result.success=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="830" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="running" value="运行中 running/cancelling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="445" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flag" value="allow_running_task_cancel？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="535" width="190" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="flag_off" value="默认 false&#xa;不设置 cancel_event&#xa;取消失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="260" y="690" width="170" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="flag_on" value="entry.state=cancelling&#xa;设置共享 cancel_event&#xa;Manager 等待 cancel_complete_event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="475" y="680" width="235" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="任务工作线程在安全检查点响应&#xa;站点 / 重试 / 动作 / 复位边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="755" y="690" width="245" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="hardware" value="硬件受控停止&#xa;AGV：move/cancel + 停止确认&#xa;JAKA：motion_abort + 稳定采样&#xa;外部轴/短操作：等待返回 + 状态确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="675" width="285" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="Future 完成&#xa;锁内选择 terminal_decision&#xa;取消时恢复安全关节位 [0,0,0,0,0,0]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1365" y="690" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="stop_ok" value="停止/状态确认/安全姿态/原任务终态落盘成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1650" y="675" width="235" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="running_success" value="机械臂已到运输安全关节位&#xa;原任务、Task、非完成Station=CANCELLED&#xa;代际墓碑 success=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1635" y="830" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="running_fail" value="取消请求失败&#xa;停止/状态/落盘失败或协调等待超时&#xa;仅硬件状态未知时：&#xa;_hardware_fault_blocked=true&#xa;阻塞后续调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1905" y="825" width="230" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="other" value="不存在 / 已完成 / 已失败 / terminalizing / 已取消代际" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="445" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="other_result" value="不存在/已终态：FAILED&#xa;已取消代际：复用墓碑结果&#xa;不重复操作硬件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="550" width="230" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="finalize" value="TaskManager 提交取消请求终态&#xa;Cancel UnifiedCommand：COMPLETED / FAILED&#xa;写 cancel_request 审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="930" width="330" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="callback" value="触发一次&#xa;on_command_status_change(cancel command)&#xa;原 TASK_CMD 不额外反馈 CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="940" width="285" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="feedback" value="RobotControlSystem 构建 ClientStreamMessage&#xa;外层：COMMAND_STATUS_UPDATE&#xa;内层：CANCEL_TASK_CMD + COMPLETED/FAILED&#xa;message 可含详情，status 为主判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1475" y="930" width="310" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="upper_result" value="上位机收到终态反馈&#xa;成功：COMPLETED&#xa;失败：FAILED&#xa;同进程去重；跨重启可幂等重放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1835" y="940" width="245" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="sent_db" value="server_command_sent&#xa;保存 COMMAND_STATUS_UPDATE&#xa;流不可用则进入离线缓存" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1495" y="1080" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="processed" value="server_command_received&#xa;processed=true" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="795" y="1085" width="260" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="gap" value="最终反馈提交后：&#xa;取消成功且无后续任务&#xa;生成优先级9内部 CHARGE_CMD&#xa;执行前复检；新任务可受控停止回充&#xa;真机验收前运行取消开关仍关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1850" y="1070" width="280" height="100" as="geometry"/>
        </mxCell>

